PREFIX=!
# Discord Bot Token(s) - Supports a comma-separated list for multi-bot sync playback (e.g. token1,token2)
DISCORD_TOKEN=your_discord_bot,token_here
MONGODB_URI=mongodb+srv://....

OWNER_IDS=your_owner_id_here

# Lavalink server (used by Pomice)
LAVALINK_URI=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass

# optional - Last.fm API (for scrobbling)
LASTFM_API_KEY=123abc
LASTFM_API_SECRET=465cba

# GitHub repository URL (for update command)
GITHUB_URL=https://github.com/diamondjirapat/Projeqt-Ayla

# optional - Custom embed images
MUSIC_BANNER_URL=http(s)://abcd
BAR_URL=http(s)://abcd

# Web Player & Discord OAuth Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback
WEB_PORT=8000
SESSION_SECRET_KEY=ayla-secret-session-key-change-this-in-production # (example: `openssl rand -base64 32`, `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
