# Python bot and internal API. Copy this file to .env in Backend/.
PREFIX=!
# Comma-separated bot tokens and numeric owner IDs.
DISCORD_TOKEN=
OWNER_IDS=
MONGODB_URI=mongodb://127.0.0.1:27017/discord_bot

# Match NODELINK_SERVER_PORT/PASSWORD in Nodelink/.env.
NODELINK_URI=http://127.0.0.1:3000
NODELINK_PASSWORD=

# Public web origin, without /webplayer or a trailing slash.
WEB_URL=http://localhost:8000
MUSIC_BANNER_URL=
BAR_URL=
GITHUB_URL=https://github.com/diamondjirapat/Projeqt-Ayla
GUILD_CACHE_MODE=fresh
# Days of logs/DD-MM-YYYY-N.log files to keep (0 keeps everything).
LOG_RETENTION_DAYS=14

# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
# Use the SAME AYLA_INTERNAL_KEY in frontend/.env.
AYLA_INTERNAL_KEY=
AYLA_INTERNAL_HOST=127.0.0.1
AYLA_INTERNAL_PORT=9000

# Optional Last.fm scrobbling credentials.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Optional social alerts. Restart the bot after changes.
SOCIAL_ALERTS_ENABLED=true
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
SOCIAL_TWITCH_POLL_SECONDS=120
SOCIAL_YOUTUBE_POLL_SECONDS=300
SOCIAL_YOUTUBE_LIVE_DISCOVERY_SECONDS=3600
SOCIAL_X_POLL_SECONDS=900
